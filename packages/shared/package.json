    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apply-tracker/typescript-config": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
