NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Public URL of the web app (email links, OAuth redirects)
WEB_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Express "trust proxy" — which proxies to trust for the client IP (rate limiting)
TRUST_PROXY=loopback

DATABASE_URL=postgresql://apply:apply@localhost:5432/apply_tracker?schema=public
REDIS_URL=redis://localhost:6380
# Background jobs (reminders, emails, weekly summaries). In production you can set this to
# false on the API and run `node dist/worker.js` as a separate process instead.
RUN_WORKERS=true

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_AGE_DAYS=30
RATE_LIMIT_ENABLED=true

# Local dev uses Mailpit (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ApplyTracker <no-reply@applytracker.local>"

# Optional: enable "Continue with Google" (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Claude-powered extraction when importing jobs from pasted text or pages
# without structured data (https://console.anthropic.com/). Leave empty to disable.
ANTHROPIC_API_KEY=
JOB_IMPORT_AI_MODEL=claude-opus-5-5

# File storage for uploaded resumes. Leave STORAGE_DRIVER empty to pick automatically:
# `s3` when S3_BUCKET is set, otherwise `database` (files kept in Postgres — no extra service,
# and safe on free hosts whose disks are wiped on every deploy).
#   s3       — AWS S3, Cloudflare R2, Backblaze B2, MinIO, Supabase Storage…
#   database — Postgres (default fallback)
#   local    — a folder on disk (dev, or a server with a persistent volume)
# Each file remembers its driver, so switching later keeps existing files readable as long as
# the old storage still exists.
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
# `auto` for Cloudflare R2
S3_REGION=us-east-1
# Empty for AWS. R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Empty = AWS default credential chain (IAM role, ~/.aws)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted S3 servers
S3_FORCE_PATH_STYLE=false
