// Prisma schema — https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased (normalised by the shared email schema).
  email           String    @unique
  name            String?
  avatarUrl       String?   @map("avatar_url")
  /// Null for accounts that only sign in with an OAuth provider.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")

  // Notification preferences
  emailReminders    Boolean  @default(true) @map("email_reminders")
  weeklySummary     Boolean  @default(true) @map("weekly_summary")
  followUpAfterDays Int      @default(7) @map("follow_up_after_days")
  timeZone          String   @default("UTC") @map("time_zone")
  /// Applications per week the user aims for; 0 = no goal.
  weeklyGoal        Int      @default(5) @map("weekly_goal")
  /// Secret token in the private calendar subscription URL.
  calendarToken     String?  @unique @map("calendar_token")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  accounts           Account[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  companies          Company[]
  applications       Application[]
  tags               Tag[]
  reminders          Reminder[]
  notifications      Notification[]
  resumes            Resume[]

  @@map("users")
}

enum OAuthProvider {
  GOOGLE
}

/// A linked OAuth identity (e.g. a Google account) for a user.
model Account {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// One signed-in device/browser. Revoking it signs that device out.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  /// Absolute lifetime; refreshing does not extend past this.
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Every refresh token ever issued for a session. Tokens are single-use:
/// presenting one that was already used means it leaked, so the session is revoked.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the token; the raw token only exists in the user's cookie.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use tokens sent by email.
model VerificationToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  type      VerificationTokenType
  /// SHA-256 of the token; the raw token only exists in the emailed link.
  tokenHash String                @unique @map("token_hash")
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

// ── Job tracking ────────────────────────────────────────────────────────────

enum ApplicationStatus {
  WISHLIST
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
  GHOSTED
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ApplicationSource {
  LINKEDIN
  INDEED
  COMPANY_WEBSITE
  REFERRAL
  RECRUITER
  FACEBOOK
  JOB_BOARD
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  BEHAVIORAL
  TAKE_HOME
  ONSITE
  FINAL
  OTHER
}

enum InterviewOutcome {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

model Company {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String
  /// Lower-cased name: "Acme" and "acme " are the same company for a user.
  normalizedName String   @map("normalized_name")
  website        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, normalizedName])
  @@map("companies")
}

model Application {
  id              String             @id @default(uuid(7)) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  roleTitle       String             @map("role_title")
  status          ApplicationStatus  @default(WISHLIST)
  /// Order within the board column (ascending). Fractional so a move only rewrites one row.
  position        Float              @default(0)
  jobUrl          String?            @map("job_url")
  /// Normalised job link (tracking parameters removed, job ids canonicalised) for duplicate detection.
  canonicalJobUrl String?            @map("canonical_job_url")
  jobDescription  String?            @map("job_description")
  location        String?
  workMode        WorkMode?          @map("work_mode")
  source          ApplicationSource?
  priority        Priority           @default(MEDIUM)
  salaryMin       Int?               @map("salary_min")
  salaryMax       Int?               @map("salary_max")
  currency        String             @default("USD") @db.Char(3)
  appliedAt       DateTime?          @map("applied_at") @db.Date
  archivedAt      DateTime?          @map("archived_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [companyId], references: [id], onDelete: NoAction)
  tags          Tag[]
  notes         Note[]
  contacts      Contact[]
  interviews    Interview[]
  statusHistory StatusChange[]
  reminders     Reminder[]
  notifications Notification[]
  resumeMatches ResumeMatch[]
  coverLetters  CoverLetter[]

  @@index([userId, status, position])
  @@index([userId, updatedAt])
  @@index([companyId])
  @@index([userId, canonicalJobUrl])
  @@map("applications")
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  color     String   @default("gray")
  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, name])
  @@map("tags")
}

model Note {
  id            String   @id @default(uuid(7)) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("notes")
}

model Contact {
  id            String   @id @default(uuid(7)) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  name          String
  role          String?
  email         String?
  phone         String?
  linkedinUrl   String?  @map("linkedin_url")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("contacts")
}

model Interview {
  id              String           @id @default(uuid(7)) @db.Uuid
  applicationId   String           @map("application_id") @db.Uuid
  type            InterviewType
  scheduledAt     DateTime         @map("scheduled_at")
  durationMinutes Int?             @map("duration_minutes")
  location        String?
  notes           String?
  outcome         InterviewOutcome @default(PENDING)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, scheduledAt])
  @@map("interviews")
}

/// Every status change, for the activity timeline and (later) analytics.
model StatusChange {
  id            String             @id @default(uuid(7)) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  changedAt     DateTime           @default(now()) @map("changed_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, changedAt])
  @@map("status_changes")
}

// ── Reminders & notifications ───────────────────────────────────────────────

model Reminder {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Optional: reminders can also be general ("Update my CV").
  applicationId String?   @map("application_id") @db.Uuid
  title         String
  note          String?
  dueAt         DateTime  @map("due_at")
  completedAt   DateTime? @map("completed_at")
  /// Set when the due notification was sent; guarantees it is sent once.
  notifiedAt    DateTime? @map("notified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([applicationId])
  @@index([dueAt])
  @@map("reminders")
}

enum NotificationType {
  REMINDER_DUE
  FOLLOW_UP_SUGGESTED
  INTERVIEW_UPCOMING
  WEEKLY_SUMMARY
}

model Notification {
  id            String           @id @default(uuid(7)) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  applicationId String?          @map("application_id") @db.Uuid
  type          NotificationType
  title         String
  body          String?
  /// In-app path to open when the notification is clicked.
  link          String?
  readAt        DateTime?        @map("read_at")
  /// Identifies the event that caused it, so retries and repeated scans never notify twice.
  dedupeKey     String?          @map("dedupe_key")
  createdAt     DateTime         @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// An uploaded resume (PDF). The file itself lives in file storage (see StorageService).
model Resume {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String
  /// Name of the uploaded file, shown to the user and used for downloads.
  fileName      String   @map("file_name")
  contentType   String   @map("content_type")
  sizeBytes     Int      @map("size_bytes")
  /// Driver that holds the file (s3 / database / local), so switching drivers keeps old files readable.
  storageDriver String   @map("storage_driver")
  storageKey    String   @unique @map("storage_key")
  /// Plain text extracted from the PDF (empty for scanned documents without a text layer).
  text          String
  pageCount     Int      @map("page_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      ResumeMatch[]
  coverLetters CoverLetter[]

  @@index([userId, createdAt])
  @@map("resumes")
}

/// File contents for the `database` storage driver — the zero-cost fallback when no S3 bucket is set.
model StoredFile {
  key         String   @id
  data        Bytes
  contentType String   @map("content_type")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("stored_files")
}

enum AiTaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// AI comparison of a resume with an application's job description (one per pair; re-running replaces it).
model ResumeMatch {
  id            String       @id @default(uuid(7)) @db.Uuid
  applicationId String       @map("application_id") @db.Uuid
  resumeId      String       @map("resume_id") @db.Uuid
  status        AiTaskStatus @default(PENDING)
  score         Int?
  summary       String?
  matchedSkills String[]     @map("matched_skills")
  missingSkills String[]     @map("missing_skills")
  suggestions   String[]
  error         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  completedAt   DateTime?    @map("completed_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resume      Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([applicationId, resumeId])
  @@map("resume_matches")
}

enum CoverLetterTone {
  PROFESSIONAL
  FRIENDLY
  ENTHUSIASTIC
}

/// An AI-drafted cover letter, which the user can then edit.
model CoverLetter {
  id            String          @id @default(uuid(7)) @db.Uuid
  applicationId String          @map("application_id") @db.Uuid
  resumeId      String?         @map("resume_id") @db.Uuid
  tone          CoverLetterTone
  /// Extra points the user asked to include.
  instructions  String?
  status        AiTaskStatus    @default(PENDING)
  content       String?
  error         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resume      Resume?     @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("cover_letters")
}
