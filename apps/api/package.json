    "bullmq": "^6.3.11",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "nestjs-pino": "^5.3.1",
